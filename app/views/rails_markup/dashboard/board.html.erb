<% content_for(:title) { "Board" } %>
<%= render "styles" %>

<div class="rm-filters rm-board-toolbar">
  <div class="rm-filter-tools" role="group" aria-label="View">
    <a href="<%= rails_markup.root_path(status: 'all') %>" class="rm-pill">List</a>
    <a href="<%= rails_markup.board_path %>" class="rm-pill rm-pill-active" aria-current="page">Board</a>
    <details class="rm-options rm-board-help"><summary aria-label="About the board"><span aria-hidden="true">ⓘ</span></summary><div class="rm-options-content">Open a card to review. Drag or use Move to change its status.</div></details>
  </div>
  <details class="rm-options"><summary>Options</summary><div class="rm-options-content">
    <div class="rm-options-heading">Toolbar</div>
    <%= render "toolbar_preferences" %>
  </div></details>
</div>

<div class="rm-layout rm-board-layout">
  <div class="rm-main">
    <div class="rm-board">
      <% {pending: "Pending", acknowledged: "Acknowledged", resolved: "Resolved", dismissed: "Dismissed"}.each do |status, label| %>
        <section class="rm-board-column" data-status="<%= status %>" aria-label="<%= label %> feedback">
          <div class="rm-board-column-header">
            <span><span class="rm-dot rm-dot-<%= status %>"></span><%= label %></span>
            <span class="rm-tab-count"><%= @columns[status].size %></span>
          </div>
          <div class="rm-board-cards">
            <% @columns[status].each do |annotation| %>
              <div class="rm-board-card" draggable="true" data-annotation-id="<%= annotation.id %>">
                <%= render "annotation_card", annotation: annotation, board: true %>
                <details class="rm-board-card-actions"><summary>Move</summary>
                  <select class="rm-board-move rm-select" data-annotation-id="<%= annotation.id %>" aria-label="Move annotation to status">
                    <% %w[pending acknowledged resolved dismissed].each do |value| %>
                      <option value="<%= value %>" <%= "selected" if annotation.status == value %>><%= value.capitalize %></option>
                    <% end %>
                  </select>
                </details>
              </div>
            <% end %>
            <div class="rm-board-empty" <%= 'hidden' if @columns[status].any? %>>No feedback</div>
          </div>
        </section>
      <% end %>
    </div>
  </div>
  <%= render "feedback_modal" %>
</div>


<script>
(function() {
  const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content;

  document.querySelectorAll('.rm-board-card').forEach(card => {
    card.addEventListener('dragstart', (e) => {
      e.dataTransfer.setData('text/plain', card.dataset.annotationId);
      e.dataTransfer.effectAllowed = 'move';
      card.style.opacity = '0.5';
    });
    card.addEventListener('dragend', () => { card.style.opacity = '1'; });
  });

  document.querySelectorAll('.rm-board-column').forEach(col => {
    col.addEventListener('dragover', (e) => {
      e.preventDefault();
      e.dataTransfer.dropEffect = 'move';
      col.classList.add('rm-drag-over');
    });
    col.addEventListener('dragleave', (e) => {
      if (!col.contains(e.relatedTarget)) col.classList.remove('rm-drag-over');
    });
    col.addEventListener('drop', (e) => {
      e.preventDefault();
      col.classList.remove('rm-drag-over');
      const id = e.dataTransfer.getData('text/plain');
      moveCard(id, col.dataset.status);
    });
  });

  // Touch fallback: status <select> on each card
  document.querySelectorAll('.rm-board-move').forEach(select => {
    select.addEventListener('change', () => {
      moveCard(select.dataset.annotationId, select.value);
    });
  });

  function moveCard(id, newStatus) {
    const card = document.querySelector('.rm-board-card[data-annotation-id="' + id + '"]');
    if (!card || card.closest('[data-status]').dataset.status === newStatus) return;

    // Optimistically move the card to the target column, then reconcile.
    const targetCol = document.querySelector('.rm-board-column[data-status="' + newStatus + '"]');
    if (targetCol) targetCol.querySelector('.rm-board-cards').appendChild(card);
    const select = card.querySelector('.rm-board-move');
    if (select) select.value = newStatus;
    updateColumnCounts();

    const basePath = window.location.pathname.replace(/\/board\/?$/, '');
    fetch(basePath + '/annotations/' + id, {
      method: 'PATCH',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': csrfToken || ''
      },
      body: JSON.stringify({ action_type: 'transition', status: newStatus })
    }).then((resp) => {
      // A rejected transition (422/401/…) resolves without throwing — resync.
      if (!resp.ok) window.location.reload();
    }).catch(() => {
      window.location.reload();
    });
  }

  function updateColumnCounts() {
    document.querySelectorAll('.rm-board-column').forEach(col => {
      const count = col.querySelectorAll('.rm-board-card').length;
      const countEl = col.querySelector('.rm-board-column-header > .rm-tab-count');
      if (countEl) countEl.textContent = count;
      const empty = col.querySelector('.rm-board-empty');
      if (empty) empty.hidden = count > 0;
    });
  }
})();
</script>
