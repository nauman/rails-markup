<% content_for(:title) { "Dashboard" } %>
<% content_for(:page_title) { "Annotations" } %>

<%= render "styles" %>

<div class="rm-workspace-heading">
  <h2>Feedback <span class="rm-heading-count"><%= @total_count %></span></h2>
  <p><%= @pending_count %> pending<% if @acknowledged_count.positive? %> · <%= @acknowledged_count %> in progress<% end %></p>
</div>

<div class="rm-layout">
  <div class="rm-main">
    <turbo-frame id="annotations-content">
      <%= render "filters" %>
      <%= render "annotation_list" %>
    </turbo-frame>
  </div>

  <%= render "feedback_modal" %>
</div>
