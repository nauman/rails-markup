<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <%= csrf_meta_tags %>
  <title><%= content_for?(:title) ? "#{yield(:title)} — Rails Markup" : "Rails Markup" %></title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body { margin: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; background: #fafbfc; color: #25272d; line-height: 1.55; }
    a { color: #4f46e5; text-decoration: none; }
    a:hover { text-decoration: underline; }
    .rm-header { background: #fff; color: #25272d; min-height: 52px; border-bottom:1px solid #e8ebef; padding: 8px max(24px, calc((100vw - 1080px) / 2)); display: flex; align-items: center; justify-content: space-between; gap: 16px; }
    .rm-header h1 { margin: 0; font-size: 14px; font-weight: 650; letter-spacing: -.025em; }
    .rm-header h1 span { display: inline-grid; place-items: center; width: 24px; height: 24px; border-radius: 7px; background: #4f46e5; color: white; margin-right: 8px; }
    .rm-header nav { display: flex; gap: 20px; flex-wrap: wrap; font-size: 13px; }
    .rm-header nav a { color: #64748b; padding: 6px 0; }
    .rm-header nav a:hover { color: #25272d; }
    .rm-container { max-width: 1128px; margin: 0 auto; padding: 28px 24px; }
    .rm-flash { padding: 12px 16px; border-radius: 8px; margin-bottom: 20px; font-size: 14px; }
    .rm-flash-notice { background: #ecfdf5; color: #065f46; border: 1px solid #a7f3d0; }
    .rm-flash-alert { background: #fef2f2; color: #991b1b; border: 1px solid #fecaca; }
    .rm-footer { max-width: 1128px; margin: 0 auto; padding: 0 24px 28px; color: #596579; font-size: 11px; text-align: left; }
    :focus-visible { outline: 3px solid #6366f1; outline-offset: 3px; }
    @media (max-width: 640px) { .rm-header { padding: 12px 16px; } .rm-container { padding: 24px 16px; } .rm-header nav { gap: 12px; } }
  </style>
</head>
<body>
  <header class="rm-header">
    <h1><span>&#9670;</span> Rails Markup</h1>
    <nav>
      <a href="<%= rails_markup.root_path %>">Dashboard</a>
      <% if RailsMarkup.config.return_url.present? %>
        <a href="<%= RailsMarkup.config.return_url %>">&#8592; Back to app</a>
      <% end %>
    </nav>
  </header>

  <main class="rm-container">
    <% if notice.present? %>
      <div class="rm-flash rm-flash-notice"><%= notice %></div>
    <% end %>
    <% if alert.present? %>
      <div class="rm-flash rm-flash-alert"><%= alert %></div>
    <% end %>

    <%= yield %>
  </main>
  <footer class="rm-footer">
    Built with love in Sydney by <a href="https://nauman.one">Nauman Tariq</a> and Pavelabs.
  </footer>
</body>
</html>
